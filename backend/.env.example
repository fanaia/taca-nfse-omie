# Identidade
SERVICE_NAME=taca-nfse-omie
SERVICE_VERSION=0.1.0
PORT=4000
NODE_ENV=development

# Banco
MONGO_URI=mongodb://localhost:27017/taca-nfse-omie

# Autenticação e autorização pela Central de Ativações
CENTRAL_ATIVACAO_URL=https://central-ativacao.central.oondemand.online
CENTRAL_ATIVACAO_API_URL=https://central-ativacao.central.oondemand.online/api/
APP_CODE=taca-nfse-omie
AUTH_PROVIDER_TIMEOUT_MS=10000

# Desenvolvimento local
DEV_TOKEN=dev-local

# Central Taça
# Segredo usado pelo modo Bearer ou HMAC-SHA256 do callback.
TACA_CALLBACK_SECRET=change-me-outside-source-control
# Quantidade máxima de Tickets processados por disparo automático (1..500).
TACA_INTEGRATION_BATCH_SIZE=100
